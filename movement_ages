## prepare Ppa-----------------------------------------------------------------------


## Set working diretory 
setwd("C:/Users*")


## Load in Track summary file
dat <- read.csv("ppa_movement_summary_dos.csv")


# Make first column into row names
dat <- data.frame(dat, row.names = 1)


# Swap rows and columns
dat_t = t(dat)
dat_t = data.frame(dat_t)


#Subset necessary columns
df = subset(dat_t, 
            select = c(Age, 
                       Absolute.peristaltic.track.length..um...forward...reversal.,
                       Peristaltic.speed..um.s...APTL...time.,
                       Wavelength..um.,
                       Mean.Amplitude..um.,
                       Turn.Count))

# Simplify column names

df <- df %>% 
  rename("tracklength" = "Absolute.peristaltic.track.length..um...forward...reversal.",
         "peristalsis" = "Peristaltic.speed..um.s...APTL...time.",
         "wavelength" = "Wavelength..um.",
         "amp" = "Mean.Amplitude..um.",
         "turns" = "Turn.Count")



# Turn columns into numeric 
df$tracklength = as.numeric(df$tracklength)
df$peristalsis = as.numeric(df$peristalsis)
df$wavelength = as.numeric(df$wavelength)
df$amp = as.numeric(df$amp)
df$turns = as.numeric(df$turns)


#remove peristalsis
df1 = subset(df, select = -c(peristalsis) )


## Multiply turncount by 6 to get turns/min
df2 <- df1
df2$turns <- df2$turns*6


# Add units to columns
df2 <- df2 %>% 
  rename("Track length (µm)" = "tracklength",
         "Wavelength (µm)" = "wavelength",
         "Amplitude (µm)" = "amp",
         "Turns / min" = "turns")


#Transform data
data_long <- gather(df2, metric, value, "Track length (µm)":"Turns / min", factor_key=TRUE)
paclon <- data_long
paclon$species <- "P. pacificus"




