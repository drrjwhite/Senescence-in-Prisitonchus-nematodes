
# Adapted from https://rviews.rstudio.com/2017/09/25/survival-analysis-with-r/

## Set working directory
setwd("C:/working_directory")

## Load in worm data
dat <- read.csv("ppa_fis_survival.csv")

## Install packages and plot Kaplan-Meier of all data (not separating by species)
library(survival)
library(ranger)
library(ggplot2)
library(dplyr)
library(ggfortify)
library(survminer)


## Set variables
# Max number of days (x axis)
a <- 50
# species
b <- "pacificus_fissidentatus"
# Experiment
d <- "survival"
# Individuals in study
e <- "300+"



# Cox proportional hazards
## Check proportional hazards assumption for Cox PH model 
res.cox = coxph(Surv(dat$time, dat$death) ~ dat$species, data = dat)
test.ph = cox.zph(res.cox)
test.ph



# Plot Schoenfeld individual test
sco <- ggcoxzph(test.ph) 
sco

## Cox test for sig dif between species
cox <- coxph(Surv(time, death) ~ species, data = dat)
summary(cox)


## Plot Kaplan-Meier of all data 
km <- with(dat, Surv(time, death))
km_fit <- survfit(Surv(time, death) ~ species, data=dat)
plot <- autoplot(km_fit, xlab="Time (days)", ylab="Survival probability", 
         main = paste(b,d,"Kaplan Meier Plot all treatments"), ylim=c(0,1), xlim = c(0,a))
plot


# Check number at risk
res <- ggsurvplot(km_fit, pval = TRUE, conf.int = TRUE,
                  risk.table = TRUE, break.time.by = 1)
res$table <- res$table + theme(axis.line = element_blank())
res$table



### Removing grey background, keeping error shading 

autoplot(survfit(Surv(time, death) ~ species, data = dat), facets = TRUE)

myplot<-autoplot(survfit(Surv(time, death) ~ species, data=dat), conf.int = TRUE, censor = FALSE,
                 xlab="Time (days)", ylab="Survival probability", 
                 ylim=c(0, 1), xlim = c(2, 45), 
                 main = "") +
  labs(col="Species")


lif <- myplot + theme(legend.position = "none", legend.title = element_text(size = 10), legend.key.size = unit(0.4, 'cm'),
                      panel.grid.major = element_blank(), panel.grid.minor = element_blank(),
                      panel.background = element_blank(), axis.line = element_line(colour = "black")) + 
 # scale_x_continuous(expand = c(0.005, 0)) + 
  scale_y_continuous(expand = c(0.005, 0)) +
  scale_fill_manual(values = c("#F8766D", "#00BA38"))

lif



## Save image

ggplot2::ggsave(lif, file=paste(b, d, "n", e, ".svg"), bg = "white", width = 4, height = 3, dpi = 500)

## Save image small
ggplot2::ggsave(lif, file=paste(b, d,"n", e, "small.svg"), 
                bg = "white", 
                width = 3, height = 2.5, dpi = 1000)

