## Set wd and load in files -----

setwd("C:/Users/*")
dat <- read.csv("Ages_smurf_dat.csv")

dat <- data.frame(dat) # Turn into data frame format
datp <- dat[dat$species == "pacificus",]
datp %>% levene_test(present ~ age)


# Libraries
library(ggplot2)
library(ggpubr)
library(dplyr)
library(Hmisc)



# Get weighted averages
avgs <- dat %>% 
  group_by(age, species) %>%
  summarise(present_mean = weighted.mean(present, weight_10),
            present_sd = sqrt(wtd.var(present, weight_10)))



# Plot
pd <- position_dodge(0.4) # move them .05 to the left and right

plot <-ggplot(avgs, aes(x = age,
                 y = present_mean,
                 colour = species,
                 group = species)) + 
  geom_point(size=2, position=pd) +
  theme_classic() +
  theme(axis.line=element_line(linewidth=1), text = element_text(size = 12), legend.position = "none") +
  scale_colour_manual(values = c("black", "blue", "lightblue")) +
  xlab("Age") +
  ylab("% animals with \n body-cavity leakage") + 
  geom_errorbar(aes(ymin=present_mean-present_sd, ymax=present_mean+present_sd), width=.25, position=pd) +
  scale_x_discrete(limits = c("ya", "old")) +
  scale_y_continuous() 

plot



