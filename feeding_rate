# Set working directory
setwd("C:/Users/*s")

# Load in data
dat <- read.csv("PpaAges_FR.csv")


# Turn into data frame format
dat <- data.frame(dat)


# Libraries
library(ggplot2)
library(ggpubr)
library(dplyr)
library(Hmisc)




# Get averages
avgs <- dat %>% 
  group_by(age) %>%
  summarise(fr_mean = mean(beadsmin),
            fr_sd = sqrt(var(beadsmin)))


avgs <- na.omit(avgs)


# Plot

inplot <- ggplot(avgs, aes(x = age, 
                 y = fr_mean)) + 
  theme_classic() +
  theme(axis.line=element_line(size=1), text = element_text(size = 12)) +
  xlab("Age") +
  ylab("Beads ingested / min") + 
  geom_errorbar(aes(ymax=fr_mean+fr_sd, ymin = ifelse(fr_mean-fr_sd < 0, 0, fr_mean-fr_sd)), width=.3, linewidth = 1.25, colour="#00BA38") +
  geom_point(size=3, colour="#00BA38") +
  scale_x_discrete(limits = c("ya", "old")) +
  ylim(0, 250)

inplot




